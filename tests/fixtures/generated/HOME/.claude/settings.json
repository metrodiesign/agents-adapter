    "additionalDirectories": [
      "${HOME}/Desktop/Project"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.docker/config.json",
        "~/Library/Keychains",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "~/.pi/agent/auth.json",
        "~/.config/agents-adapter/config.yaml"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.docker/config.json",
        "~/Library/Keychains",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "~/.pi/agent/auth.json",
        "~/.config/agents-adapter/config.yaml",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.profile",
        "~/.gitconfig"
      ],
      "allowWrite": [
        "${HOME}/Desktop/Project",
        "${HOME}/.claude",
        "${HOME}/.codex",
        "${HOME}/.pi"
      ]
    },
    "excludedCommands": [
      "gh *",
      "docker *",
      "codex *",
      "dotnet test *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "localhost",
        "127.0.0.1",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "*.nuget.org",
        "packagist.org",
        "repo.packagist.org",
        "pypi.org",
        "files.pythonhosted.org",
        "*.rubygems.org",
        "repo.maven.apache.org",
        "services.gradle.org",
        "proxy.golang.org",
        "sum.golang.org",
        "index.crates.io",
        "static.crates.io",
        "registry-1.docker.io",
        "auth.docker.io",
        "mcr.microsoft.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
