{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agents-adapter user config",
  "type": "object",
  "required": ["version", "development_roots", "protected_branches"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "development_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "protected_branches": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" } },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "owner": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
    },
    "trusted_domains": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9.*-]+$" } },
    "development_env_patterns": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9.*_-]+$" } },
    "production_env_patterns": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9.*_-]+$" } },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation_mode": { "type": "string", "enum": ["host-macos", "docker", "gondolin", "openshell"] }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": { "type": "boolean" },
        "codex": { "type": "boolean" },
        "pi": { "type": "boolean" }
      }
    }
  }
}
